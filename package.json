{
  "name": "duckhive",
  "version": "0.13.7",
  "description": "DuckHive opens coding-agent workflows to any LLM - OpenAI, Gemini, DeepSeek, Ollama, and 200+ models",
  "type": "module",
  "bin": {
    "duckhive": "./bin/duckhive"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/cli.mjs": "./dist/cli.mjs",
    "./sdk": {
      "types": "./src/entrypoints/sdk.d.ts",
      "import": "./dist/sdk.mjs"
    },
    "./harness": {
      "types": "./src/entrypoints/harness.d.ts",
      "import": "./dist/harness.mjs"
    }
  },
  "files": [
    "bin/duckhive",
    "bin/duckhive.cmd",
    "bin/duckhive-config-loader.js",
    "bin/duckhive-provider-bootstrap.js",
    "bin/import-specifier.mjs",
    "bin/tui-pty-helper.py",
    "config/",
    "dist/cli.mjs",
    "dist/harness.mjs",
    "dist/sdk.mjs",
    "install.ps1",
    "install.sh",
    "scripts/install.ps1",
    "scripts/install.sh",
    "skills/newest-desktop-control/docs/",
    "skills/newest-desktop-control/package.json",
    "skills/newest-desktop-control/README.md",
    "skills/newest-desktop-control/scripts/",
    "skills/newest-desktop-control/SKILL.md",
    "skills/newest-desktop-control/src/",
    "src/entrypoints/harness.d.ts",
    "src/entrypoints/sdk.d.ts",
    "src/entrypoints/sdk/coreTypes.generated.d.ts",
    "src/entrypoints/sdk/coreTypes.generated.ts",
    "tui/bridge.go",
    "tui/cmd/",
    "tui/duckhive-tui.exe",
    "tui/go.mod",
    "tui/go.sum",
    "tui/model.go",
    "tui/model/",
    "tui/styles.go",
    "tui/tui/",
    "tui/update.go",
    "tui/view.go",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "integrations:generate": "bun run scripts/generate-integrations-artifacts.ts",
    "integrations:check": "bun run scripts/generate-integrations-artifacts.ts --check",
    "gitnexus": "gitnexus",
    "dev": "bun run build && node dist/cli.mjs",
    "dev:profile": "bun run scripts/provider-launch.ts",
    "dev:profile:fast": "bun run scripts/provider-launch.ts auto --fast --bare",
    "dev:codex": "bun run scripts/provider-launch.ts codex",
    "dev:openai": "bun run scripts/provider-launch.ts openai",
    "dev:gemini": "bun run scripts/provider-launch.ts gemini",
    "dev:ollama": "bun run scripts/provider-launch.ts ollama",
    "dev:ollama:fast": "bun run scripts/provider-launch.ts ollama --fast --bare",
    "dev:atomic-chat": "bun run scripts/provider-launch.ts atomic-chat",
    "profile:init": "bun run scripts/provider-bootstrap.ts",
    "profile:recommend": "bun run scripts/provider-recommend.ts",
    "profile:auto": "bun run scripts/provider-recommend.ts --apply",
    "profile:codex": "bun run profile:init -- --provider codex --model codexplan",
    "profile:fast": "bun run profile:init -- --provider ollama --model llama3.2:3b",
    "profile:code": "bun run profile:init -- --provider ollama --model qwen2.5-coder:7b",
    "dev:fast": "bun run profile:fast && bun run dev:ollama:fast",
    "dev:code": "bun run profile:code && bun run dev:profile",
    "dev:grpc": "bun run scripts/start-grpc.ts",
    "dev:grpc:cli": "bun run scripts/grpc-cli.ts",
    "start": "node dist/cli.mjs",
    "start:local": "node bin/duckhive",
    "dev:local": "bun run build && node bin/duckhive",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:preview": "bun run --cwd web preview",
    "web:typecheck": "bun run --cwd web typecheck",
    "webui:api": "bun run src/services/webui-server/webui-api-server.ts",
    "webui:install": "bun install --cwd webui",
    "webui:dev": "bun run webui:install && bun run --cwd webui dev",
    "webui:build": "bun run webui:install && bun run --cwd webui build",
    "webui:preview": "bun run webui:install && bun run --cwd webui preview",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage --max-concurrency=1 && bun run scripts/render-coverage-heatmap.ts",
    "test:coverage:ui": "bun run scripts/render-coverage-heatmap.ts",
    "security:pr-scan": "bun run scripts/pr-intent-scan.ts",
    "test:provider-recommendation": "bun test src/utils/providerRecommendation.test.ts src/utils/providerProfile.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bun test src/ink/components/App.stdinMode.test.ts src/components/TextInput.test.tsx && bun run build && bun run scripts/cli-smoke.ts",
    "verify:privacy": "bun run scripts/verify-no-phone-home.ts",
    "build:verified": "bun run build && bun run verify:privacy",
    "test:provider": "bun test src/services/api/*.test.ts src/utils/context.test.ts",
    "doctor:runtime": "bun run scripts/system-check.ts",
    "doctor:runtime:json": "bun run scripts/system-check.ts --json",
    "doctor:runtime:strict": "bun run scripts/system-check.ts --strict-interactive",
    "doctor:runtime:strict:json": "bun run scripts/system-check.ts --json --strict-interactive",
    "doctor:report": "bun run scripts/system-check.ts --out reports/doctor-runtime.json",
    "council:serve": "node src/services/council-server/council-api-server.cjs",
    "hardening:check": "bun run smoke && bun run doctor:runtime",
    "hardening:strict": "bun run typecheck && bun run hardening:check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@anthropic-ai/bedrock-sdk": "0.29.1",
    "@anthropic-ai/foundry-sdk": "0.2.3",
    "@anthropic-ai/sandbox-runtime": "0.0.46",
    "@anthropic-ai/sdk": "0.91.1",
    "@anthropic-ai/vertex-sdk": "0.16.0",
    "@commander-js/extra-typings": "12.1.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@mendable/firecrawl-js": "4.23.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@vscode/ripgrep": "^1.17.1",
    "ajv": "8.18.0",
    "auto-bind": "5.0.1",
    "axios": "1.15.2",
    "better-sqlite3": "^12.10.0",
    "bidi-js": "1.0.3",
    "chalk": "5.6.2",
    "chokidar": "4.0.3",
    "cli-boxes": "3.0.0",
    "cli-highlight": "2.1.11",
    "code-excerpt": "4.0.0",
    "commander": "12.1.0",
    "cors": "^2.8.5",
    "cross-spawn": "7.0.6",
    "diff": "8.0.3",
    "duck-duck-scrape": "^2.2.7",
    "emoji-regex": "10.6.0",
    "env-paths": "3.0.0",
    "execa": "9.6.1",
    "express": "^5.1.0",
    "fflate": "0.8.2",
    "figures": "6.1.0",
    "fuse.js": "7.1.0",
    "get-east-asian-width": "1.5.0",
    "google-auth-library": "9.15.1",
    "graphology": "^0.26.0",
    "graphology-pagerank": "^1.1.0",
    "https-proxy-agent": "7.0.6",
    "ignore": "7.0.5",
    "imap": "^0.8.19",
    "indent-string": "5.0.0",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.1",
    "lru-cache": "11.2.7",
    "marked": "15.0.12",
    "nodemailer": "^8.0.7",
    "p-map": "7.0.4",
    "picomatch": "4.0.4",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-compiler-runtime": "1.0.0",
    "react-reconciler": "0.33.0",
    "semver": "7.7.4",
    "sharp": "^0.34.5",
    "shell-quote": "1.8.3",
    "signal-exit": "4.1.0",
    "stack-utils": "2.0.6",
    "strip-ansi": "7.2.0",
    "supports-hyperlinks": "3.2.0",
    "tree-kill": "1.2.2",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "7.2.2",
    "type-fest": "4.41.0",
    "undici": "7.24.6",
    "usehooks-ts": "3.1.1",
    "vscode-languageserver-protocol": "3.17.5",
    "web-tree-sitter": "^0.26.8",
    "wrap-ansi": "9.0.2",
    "ws": "8.20.0",
    "xss": "1.0.15",
    "yaml": "2.8.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "gitnexus": "1.6.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Franzferdinan51/DuckHive.git"
  },
  "keywords": [
